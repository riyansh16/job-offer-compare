// Prisma schema for the Job Offer Comparison Portal.
// Uses PostgreSQL in both dev and prod. The schema is identical across them
// so a single `DATABASE_URL` swap moves between environments.

generator client {
  provider      = "prisma-client-js"
  // Bundle multiple Linux engine builds so the Prisma Client works on both
  // dev (native macOS/Windows) and Azure SWA's runtime (Debian + openssl 1.1).
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NextAuth tables (Auth.js v5 with @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?   @db.VarChar(128)  // null for OAuth-only users; bcrypt hashes are 60 chars—cap guards against accidental plaintext writes
  // Total years of professional experience. User sets it once (e.g. on
  // signup or via Profile settings); used to filter external compensation
  // signals (e.g. LeetCode posts) to peers in the same YoE band.
  yearsExperience Int?
  // Lightweight usage telemetry (bumped by the events.signIn hook in auth.ts).
  // Lets the /admin/stats page report DAU and total sign-in volume without
  // a separate UsageEvent table.
  lastSignInAt    DateTime?
  signInCount     Int       @default(0)

  // Monotonic lifetime counters. Bumped on create (inside a $transaction
  // alongside the entity insert), NEVER decremented on delete. Together
  // with the row-based count() queries on /admin/stats this gives us:
  //   - "currently exists" (count of JobOffer/Comparison/AiInsight rows)
  //   - "ever happened"    (sum of lifetime* across all users)
  //   - "delete rate"      ((lifetime - current) / lifetime)
  // lifetimeAiInsights is bumped only when the LLM was actually called
  // (not on cache hits in src/app/api/comparisons/[id]/ai/route.ts), so
  // it doubles as the real cost-attributable usage number.
  lifetimeOffers       Int @default(0)
  lifetimeComparisons  Int @default(0)
  lifetimeAiInsights   Int @default(0)

  createdAt      DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  offers         JobOffer[]
  comparisons    Comparison[]
  weightProfiles WeightProfile[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

model Company {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  website           String?
  hqLocation        String?
  size              String?  // e.g. "10000+", "1001-5000"
  industry          String?
  redditQuery       String?  // optional override for Reddit search
  tickerSymbol      String?
  isPublic          Boolean  @default(false)

  // Manually entered ratings from public review sites (user enters with source URL).
  // Overall (0-5).
  // Indeed is the only fetched source (see src/lib/providers/llmRatings.ts).
  indeedRating      Float?
  indeedUrl         String?

  // Indeed sub-ratings (0-5 each).
  indeedCompBenefits     Float?
  indeedWLB              Float?
  indeedJobSecurity      Float?
  indeedMgmt             Float?
  indeedCulture          Float?
  indeedReviewCount      Int?

  // Layoffs.fyi-derived signal: percentage of headcount laid off in last 12 months.
  // Informational only — NOT factored into scoring (backward-looking, noisy).
  // Shown on the company page and at the top of comparison results.
  // Refreshed monthly via scripts/refreshLayoffs.ts.
  layoffsLast12mPct      Float?
  layoffsAsOf            DateTime?
  layoffsSourceUrl       String?
  layoffsUpdatedAt       DateTime?

  ratingsUpdatedAt  DateTime?
  // Tracks every ratings refresh attempt (success or fail). Used by the batch
  // refresher to pick the stalest companies in oldest-first order without
  // endlessly retrying companies whose fetch keeps failing. Renamed from
  // `lastFetchAttemptAt` (May 15, 2026) for clarity now that other fetched
  // signals (e.g. `layoffsUpdatedAt`) also live on this model.
  ratingsLastFetchAttemptAt DateTime?

  // Cached stock metrics from Yahoo Finance. Refreshed lazily by
  // src/lib/providers/stockPrice.ts when stockUpdatedAt is older than 6h
  // and the company is being scored. Replaces the old StockPriceHistory
  // table which stored ~1300 daily close rows per company just to
  // recompute these 3 numbers - the daily series was never read.
  stockCagr5yPct       Float?
  stockCagr1yPct       Float?
  stockCurrentPriceUsd Float?
  stockUpdatedAt       DateTime?

  createdAt         DateTime @default(now())

  offers            JobOffer[]
  sentiments        ReviewSentiment[]
}

model JobOffer {
  id           String   @id @default(cuid())
  userId       String
  companyId    String
  title        String
  level        String?
  location     String   // city, used for COL adjustment
  isCurrent    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict (the default) prevents deleting a catalog company while any user
  // still has an offer pointing at it. Made explicit so a future reader
  // doesn't have to remember the Prisma default.
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  compensation Compensation?

  @@index([userId])
}

// 1:1 with JobOffer. Stored separately for clarity and to allow versioning later.
model Compensation {
  id                  String   @id @default(cuid())
  offerId             String   @unique
  // All monetary values are in INR. The product currently supports only Indian offers.
  baseSalary          Float
  targetBonusPct      Float    @default(0)
  signOnBonus         Float    @default(0)
  equityTotal         Float    @default(0)   // ₹ value of equity that vests in year 1
  benefitsValueAnnual Float    @default(0)   // annualized INR value of health/PF/etc.
  ptoDays             Int      @default(0)
  workMode            String   @default("Onsite") // Remote | Hybrid | Onsite
  commuteCostMonthly  Float    @default(0)
  qualitativeScore    Int      @default(50)  // 0-100, user-supplied "growth/fit"

  offer JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

// Weight profile -> 100-point distribution across the 12 metrics:
//   salary, bonus, equity, signOn, benefits, workMode, growth,
//   reviewCompBenefits, reviewWLB, reviewCulture, reviewMgmt,
//   reviewJobSecurityAndAdvancement.
// (Older names like `pto`, `colAdjusted`, `reviews` were removed pre-launch.)
// userId null => system preset (visible to all).
model WeightProfile {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  isPreset  Boolean  @default(false)
  // Weights as JSON: { salary, bonus, equity, signOn, benefits, workMode, growth,
  //                    reviewCompBenefits, reviewWLB, reviewCulture, reviewMgmt,
  //                    reviewJobSecurityAndAdvancement }
  weights   String
  createdAt DateTime @default(now())

  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comparisons Comparison[]

  @@index([userId])
}

model Comparison {
  id          String   @id @default(cuid())
  userId      String
  name        String
  profileId   String?
  // JSON snapshot: { offers: [...computed values...], weights: {...}, results: [...] }
  snapshotJson String
  // Equity-growth assumption used (per-comparison override).
  equityGrowthPct Float @default(0)
  // CSV of offer IDs in display order.
  offerIdsCsv String
  createdAt   DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile  WeightProfile? @relation(fields: [profileId], references: [id])
  insights AiInsight[]

  @@index([userId])
}

model ReviewSentiment {
  id         String   @id @default(cuid())
  companyId  String
  source     String   // Reddit | HackerNews | Manual
  score      Float    // -1..1
  sampleSize Int
  summary    String   // brief aggregated text
  fetchedAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // One row per (company, source) so the upsert in refreshCompanySentiment
  // can target it directly instead of doing find-then-update (which had a
  // race window where two concurrent refreshes could both insert).
  @@unique([companyId, source])
  @@index([companyId, source])
}

model AiInsight {
  id           String   @id @default(cuid())
  comparisonId String
  kind         String   // Verdict | Tradeoffs | Negotiation | Questions
  content      String
  model        String
  generatedAt  DateTime @default(now())

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  // Regenerating an insight replaces the previous one instead of appending,
  // so we can upsert by (comparisonId, kind). Without this, multiple
  // 'Verdict' rows could accumulate per comparison.
  @@unique([comparisonId, kind])
  @@index([comparisonId, kind])
}
