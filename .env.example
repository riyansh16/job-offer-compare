# --- Database ---
# PostgreSQL in both dev and prod (the Prisma schema uses the `postgresql`
# provider, so SQLite is not supported). A single DATABASE_URL swap moves
# between environments.
#   Local dev:     postgresql://postgres:postgres@localhost:5432/joboffer?sslmode=disable
#   Azure Postgres: postgresql://user:pass@host.postgres.database.azure.com:5432/joboffer?sslmode=require
#
# For Azure Postgres Burstable (B1ms) tier on a serverless host like Azure
# SWA, append ?connection_limit=3&pool_timeout=10&sslmode=require -- B1ms
# allows 50 max connections total but reserves 15 for replication/monitoring,
# leaving ~35 for the app. Each cold SWA Function invocation opens a new Prisma
# pool, so capping at 3 per pool keeps headroom for cron scripts + manual psql
# sessions and prevents "too many clients" outages. (Burstable tiers can't use
# Azure's built-in PgBouncer, so this per-pool cap is the only safeguard.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/joboffer?sslmode=disable"

# --- NextAuth (Auth.js v5) ---
# Long random string, different per environment. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Canonical public URL used by sitemap, robots, Open Graph, and JSON-LD.
# Set this in production to your real site URL, e.g. https://offerlens.in
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Required behind reverse proxies (Azure SWA, Vercel). Leave unset in local dev.
# AUTH_TRUST_HOST=true

# --- Google OAuth (optional in dev, REQUIRED in prod) ---
# From https://console.cloud.google.com → Google Auth Platform → Clients
# Authorized redirect URI in Google Console must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-prod-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Admin ---
# Email address whose user can access /admin/stats. Anyone else hitting that
# route gets a 404. The admin nav link is also hidden from non-admins.
ADMIN_EMAIL=""

# --- Application Insights (page-view tracking) ---
# Client-side analytics: page views, sessions, geo, slow-route detection in
# the Azure portal. Replaces the previous server-side per-render DB upsert.
# Get the connection string from the Application Insights resource overview
# blade. Must be NEXT_PUBLIC_* so it ships to the browser. Leave blank in
# dev to disable analytics entirely (component no-ops).
NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=""

# --- AI provider ---
# AI_ENABLED=true to show AI features in the UI.
AI_ENABLED="true"
# AI_PROVIDER: "github-models" (default, free) or "azure-openai".
AI_PROVIDER="github-models"
# Default model on GitHub Models. gpt-4o-mini for quality, Phi-4 for higher rate limits.
AI_MODEL="gpt-4o-mini"

# --- GitHub Models (free tier) ---
# A fine-grained PAT with the "models:read" scope. Create at https://github.com/settings/tokens
GITHUB_TOKEN=""

# --- Azure OpenAI (only used when AI_PROVIDER=azure-openai) ---
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"

# --- Reddit OAuth (optional, free; required for Reddit sentiment) ---
# Register a script app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="job-offer-compare/0.1 by your-reddit-username"

# --- Gemini (Indeed ratings via grounded search) ---
# Free tier on https://aistudio.google.com/apikey is ~20 requests/day per
# model per key. With 164 companies we hit that limit fast, so the fetcher
# (src/lib/providers/llmRatings.ts) supports up to 10 keys with auto-failover:
# when one key returns a daily-quota 429, it transparently rotates to the
# next. Use multiple Google accounts to multiply the free quota.
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
GEMINI_API_KEY_5=""
GEMINI_API_KEY_6=""
GEMINI_API_KEY_7=""
# Override the default model. Each model has its own per-day quota bucket.
# GEMINI_RATINGS_MODEL="gemini-2.5-flash-lite"

# --- Demo seed ---
# Set true to populate sample companies + a demo comparison.
SEED_DEMO="false"
